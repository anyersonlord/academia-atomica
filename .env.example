# ==============================================================================
# Academia Atómica: Grupos Electrógenos — Plantilla de Entorno (SIN SECRETOS)
# Copiar a .env.local y completar únicamente en tu máquina local.
# ==============================================================================

# Supabase Público (seguro para navegador; sujeto a políticas RLS estrictas)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Supabase Servidor (NUNCA exponer al cliente ni en repositorios)
SUPABASE_SECRET_KEY=sb_secret_<key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL (codificar '#' como '%23' en la contraseña)
# Usar Session Pooler (IPv4) para DATABASE_URL en Windows
DATABASE_URL=postgresql://postgres.<project-ref>:<URL_ENCODED_PASSWORD>@aws-1-us-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# Cuenta personal única (bootstrap local con auth.uid() real; usar comillas si contiene '#')
BOOTSTRAP_USER_EMAIL="tu-correo@ejemplo.com"
BOOTSTRAP_USER_PASSWORD="CambiaEstaContrasenaSegura123!"
